# 않았을 때만 같은 후보 순서로 절대경로를 한 번 더 찾는다.
if ! command -v "$CODEX_BIN" >/dev/null 2>&1 && [ "$CODEX_BIN_EXPLICIT" != "1" ]; then
  for candidate in "$HOME/.local/bin/codex" /opt/homebrew/bin/codex /usr/local/bin/codex; do
