if [ "$SELECTED_ACCOUNT" = "biz" ]; then LOGDIR="$HOME/.codex-runs-biz"; else LOGDIR="$HOME/.codex-runs"; fi
MKDIR_OUTPUT=""
if ! MKDIR_OUTPUT="$(umask 077; mkdir -p "$LOGDIR" 2>&1)"; then
  if [ -n "$MKDIR_OUTPUT" ]; then
    echo "codex-run: cannot prepare log directory: $LOGDIR ($MKDIR_OUTPUT); no child started (exit $LOG_SETUP_RC)" >&2
  else
    echo "codex-run: cannot prepare log directory: $LOGDIR; no child started (exit $LOG_SETUP_RC)" >&2
  fi
  exit "$LOG_SETUP_RC"
