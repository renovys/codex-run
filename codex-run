if [ ! -d "$LOGDIR" ] || [ -L "$LOGDIR" ] || [ ! -r "$LOGDIR" ] || [ ! -x "$LOGDIR" ] || [ ! -w "$LOGDIR" ]; then
  echo "codex-run: cannot use log directory: $LOGDIR; no child started (exit $LOG_SETUP_RC)" >&2
  exit "$LOG_SETUP_RC"
fi
log_setup_chmod 700 "$LOGDIR" "log directory"
find "$LOGDIR" -name '*.log' -mtime +14 -delete 2>/dev/null   # Prune run logs older than 14 days.
STAMP="$(date +%Y%m%d-%H%M%S)"
LOG_BASE="$LOGDIR/$STAMP-$$"
LOG="$LOG_BASE.log"
LOG_SEQ=0
LOG_CREATED=0
while [ "$LOG_SEQ" -le 99 ]; do
  if [ -e "$LOG" ] || [ -L "$LOG" ]; then
    LOG_SEQ=$((LOG_SEQ + 1))
    LOG="$LOG_BASE-$LOG_SEQ.log"
    continue
  fi
  if (umask 077; set -C; : > "$LOG") 2>/dev/null; then
    LOG_CREATED=1
    break
  fi
  LOG_SEQ=$((LOG_SEQ + 1))
  LOG="$LOG_BASE-$LOG_SEQ.log"
done
if [ "$LOG_CREATED" != "1" ]; then
  echo "codex-run: cannot create a private log file in $LOGDIR; no child started (exit $LOG_SETUP_RC)" >&2
  exit "$LOG_SETUP_RC"
fi
