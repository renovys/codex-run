[ "$LEFT" = "1" ] && echo "warning: codex process still running (PID $CPID) - inspect it before delegating again"
echo "decision at: ${DECISION_ELAPSED}s / total elapsed: ${TOTAL_ELAPSED}s / full log: $LOG"
# 요약줄만 보는 자동화가 "정상 종료했지만 실패한 실행"을 성공으로 읽지 않게 한다.
STATUS="$REASON"
[ "$REASON" = "ok" ] && [ "$RC" != "0" ] && STATUS="failed"
if [ "$LOG_SETUP_WARN" = "1" ]; then
  echo "codex-run: status=$STATUS exit_code=$RC elapsed_sec=$TOTAL_ELAPSED log=$LOG account=$SELECTED_ACCOUNT route=$ROUTE_REASON probe=$PROBE_SEC wrapper_warning=log_setup codex_exit_code=${CODEX_RC:-n/a}"
else
  echo "codex-run: status=$STATUS exit_code=$RC elapsed_sec=$TOTAL_ELAPSED log=$LOG account=$SELECTED_ACCOUNT route=$ROUTE_REASON probe=$PROBE_SEC"
fi
exit "$RC"
