#!/usr/bin/env bash
# codex-run - watchdog wrapper for delegated GPT-5.6 Sol (codex) runs
# It detects unresponsive runs through a wall-clock limit or output silence, kills the process tree,
# and records the log path and termination reason in a standard format so the calling agent can take over.
# Usage: codex-run [--timeout SEC] [--stall SEC] [--stdin FILE] [--tail N] [--codex-bin PATH]
#                  [--help] [--version] [--] <codex args...>
#   Example: codex-run --timeout 900 exec --sandbox danger-full-access "prompt"
# Exit codes: 0=success / 124=wall-clock limit / 125=output stall / 2=usage or argument error / other=codex exit code
# Compatible with macOS bash 3.2 (no associative arrays or flock).
set -u

VERSION="0.1.0"

usage() {
  cat <<'EOF'
Usage:
  codex-run [--timeout SEC] [--stall SEC] [--stdin FILE] [--tail N] [--codex-bin PATH]
            [--help] [--version] [--] <codex args...>

Options:
  --timeout SEC     Wall-clock limit (seconds, default: 900, minimum: 1)
  --stall SEC       Output-silence timeout (seconds, default: 0=off)
  --stdin FILE      Regular file to use as codex standard input
  --tail N          Log lines to print after exit (default: 40)
  --codex-bin PATH  codex executable (default: codex)
  --help            Print this help
  --version         Print version
  --                Stop parsing wrapper arguments

Environment:
  CODEX_RUN_TIMEOUT, CODEX_RUN_STALL, CODEX_RUN_TAIL, CODEX_BIN
EOF
}

die() { echo "codex-run: $1" >&2; exit 2; }
is_num() { case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }
validate_num() { # $1=name, $2=value, $3=minimum
  is_num "$2" || die "$1 must be numeric"
  [ "$2" -ge "$3" ] 2>/dev/null || die "$1 must be at least $3"
}

if [ "${CODEX_RUN_TIMEOUT+x}" = "x" ]; then LIMIT="$CODEX_RUN_TIMEOUT"; else LIMIT=900; fi
if [ "${CODEX_RUN_STALL+x}" = "x" ]; then STALL="$CODEX_RUN_STALL"; else STALL=0; fi
if [ "${CODEX_RUN_TAIL+x}" = "x" ]; then TAIL_LINES="$CODEX_RUN_TAIL"; else TAIL_LINES=40; fi
STDIN_FILE="/dev/null"
CODEX_BIN="${CODEX_BIN:-codex}"

while [ $# -gt 0 ]; do
  case "$1" in
    --timeout)   [ $# -ge 2 ] || die "--timeout requires a value"; validate_num "--timeout" "$2" 1; LIMIT="$2"; shift 2 ;;
    --stall)     [ $# -ge 2 ] || die "--stall requires a value";   validate_num "--stall" "$2" 0; STALL="$2"; shift 2 ;;
    --stdin)     [ $# -ge 2 ] || die "--stdin requires a value"; [ -f "$2" ] && [ -r "$2" ] || die "cannot read stdin regular file: $2"; STDIN_FILE="$2"; shift 2 ;;
    --tail)      [ $# -ge 2 ] || die "--tail requires a value";    validate_num "--tail" "$2" 0; TAIL_LINES="$2"; shift 2 ;;
    --codex-bin) [ $# -ge 2 ] || die "--codex-bin requires a value"; [ -n "$2" ] || die "--codex-bin value is empty"; CODEX_BIN="$2"; shift 2 ;;
    --help)      usage; exit 0 ;;
    --version)   echo "codex-run $VERSION"; exit 0 ;;
    --)          shift; break ;;
    *)           break ;;
  esac
done

validate_num "--timeout/CODEX_RUN_TIMEOUT" "$LIMIT" 1
validate_num "--stall/CODEX_RUN_STALL" "$STALL" 0
validate_num "--tail/CODEX_RUN_TAIL" "$TAIL_LINES" 0
[ $# -gt 0 ] || die "no arguments. See codex-run --help"

LOGDIR="$HOME/.codex-runs"
(umask 077; mkdir -p "$LOGDIR")
chmod 700 "$LOGDIR" || die "cannot set log directory permissions: $LOGDIR"
find "$LOGDIR" -name '*.log' -mtime +14 -delete 2>/dev/null   # Prune run logs older than 14 days.
STAMP="$(date +%Y%m%d-%H%M%S)"
LOG="$LOGDIR/$STAMP-$$.log"
(umask 077; : > "$LOG")
chmod 600 "$LOG" || die "cannot set log file permissions: $LOG"

mtime_of() {   # File modification time (epoch), with separate Linux and macOS forms.
  if stat -c %Y "$1" 2>/dev/null; then return 0; fi
  stat -f %m "$1" 2>/dev/null
}

# Add --skip-git-repo-check to delegated exec runs because codex otherwise rejects non-git working directories.
if [ "${1:-}" = "exec" ]; then
  HAS_SKIP=0
  for a in "$@"; do [ "$a" = "--skip-git-repo-check" ] && HAS_SKIP=1; done
  if [ "$HAS_SKIP" != "1" ]; then
    shift
    set -- exec --skip-git-repo-check "$@"
  fi
fi

# Job control makes the background child lead its own process group (PGID=child PID).
# That lets termination clean up the entire group, including grandchildren, in one operation.
set -m

kill_tree() {   # $1 = signal
  kill -"$1" -"$CPID" 2>/dev/null     # Entire process group.
  pkill -"$1" -P "$CPID" 2>/dev/null  # Also catch direct children that escaped the group.
  kill -"$1" "$CPID" 2>/dev/null
}

cleanup() {     # Do not orphan codex when the wrapper is terminated externally.
  [ -n "${CPID:-}" ] || return 0
  kill_tree TERM
  sleep 5
  kill_tree KILL
  wait "$CPID" 2>/dev/null
}
trap 'cleanup; exit 143' INT TERM HUP

START=$SECONDS
{
  echo "# codex-run start: $(date '+%Y-%m-%d %H:%M:%S') / timeout ${LIMIT}s / stall ${STALL}s / stdin ${STDIN_FILE}"
  echo "# command: $CODEX_BIN $*"
  echo "#---"
} >> "$LOG"

# Close stdin with /dev/null by default because leaving it open can make codex wait forever for more input.
"$CODEX_BIN" "$@" >>"$LOG" 2>&1 <"$STDIN_FILE" &
CPID=$!
set +m

LAST_MTIME=""
if CURRENT_MTIME="$(mtime_of "$LOG")"; then LAST_MTIME="$CURRENT_MTIME"; fi
LAST_ACTIVITY=$SECONDS

REASON="ok"
DECISION_ELAPSED=0
while kill -0 "$CPID" 2>/dev/null; do
  sleep 1
  kill -0 "$CPID" 2>/dev/null || break   # A normal exit during sleep must not be mistaken for a limit breach.
  NOW=$SECONDS
  ELAPSED=$(( NOW - START ))
  if [ "$ELAPSED" -ge "$LIMIT" ]; then
    REASON="timeout"
    DECISION_ELAPSED=$ELAPSED
    break
  fi
  # If stat fails, skip only this iteration's stall decision.
  if CURRENT_MTIME="$(mtime_of "$LOG")"; then
    if [ -z "$LAST_MTIME" ] || [ "$CURRENT_MTIME" != "$LAST_MTIME" ]; then
      LAST_MTIME="$CURRENT_MTIME"
      LAST_ACTIVITY=$NOW
    fi
    IDLE=$(( NOW - LAST_ACTIVITY ))
    if [ "$STALL" -gt 0 ] && [ "$IDLE" -ge "$STALL" ]; then
      REASON="stall"
      DECISION_ELAPSED=$ELAPSED
      break
    fi
  fi
done

if [ "$REASON" = "ok" ]; then
  wait "$CPID"
  RC=$?
  DECISION_ELAPSED=$(( SECONDS - START ))
else
  kill_tree TERM
  sleep 5
  # Always send KILL to the group because a TERM-ignoring grandchild may survive after the leader exits.
  kill_tree KILL
  wait "$CPID" 2>/dev/null
  if [ "$REASON" = "timeout" ]; then RC=124; else RC=125; fi
fi
trap - INT TERM HUP

# Check for survivors so the caller knows about them before taking over.
LEFT=0
kill -0 "$CPID" 2>/dev/null && LEFT=1
kill -0 -"$CPID" 2>/dev/null && LEFT=1

TOTAL_ELAPSED=$(( SECONDS - START ))
echo "----- codex output (last ${TAIL_LINES} lines) -----"
tail -n "$TAIL_LINES" "$LOG"
echo "----- codex-run summary -----"
case "$REASON" in
  ok)      echo "status: exited normally (codex exit code $RC)" ;;
  timeout) echo "status: wall-clock limit of ${LIMIT}s exceeded - terminated; caller should take over" ;;
  stall)   echo "status: no output for ${STALL}s (presumed stalled) - terminated; caller should take over" ;;
esac
[ "$LEFT" = "1" ] && echo "warning: codex process still running (PID $CPID) - inspect it before delegating again"
echo "decision at: ${DECISION_ELAPSED}s / total elapsed: ${TOTAL_ELAPSED}s / full log: $LOG"
echo "codex-run: status=$REASON exit_code=$RC elapsed_sec=$TOTAL_ELAPSED log=$LOG"
exit "$RC"
